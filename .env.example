# LLM (Gemini) — narasi, pemecahan adegan, metadata
GEMINI_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-2.0-flash
LLM_PROVIDER=gemini

# T2I (HF Inference + FLUX.1)
# Kunci HuggingFace TIDAK lagi lewat .env. Isi lewat UI di bagian
# "Kunci API", supaya bisa ditambah atau dimatikan tanpa restart server.
# Disimpan di data/keys.json (tidak masuk git).
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_PROVIDER=hf_inference

# TTS (edge-tts, no key needed)
TTS_PROVIDER=edge_tts
TTS_LANG=id-ID

# Video (Ken Burns)
VIDEO_PROVIDER=ken_burns

# Style
STYLE_PREFIX_DEFAULT=ink sketch aesthetic, hand-drawn illustration, sepia tones, parchment background
